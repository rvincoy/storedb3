# Copy this file to .env and fill in real values. .env is gitignored.

PORT=8080

# Dev/prod database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Separate test database, used automatically when NODE_ENV=test (see db/connect.js).
# This should point at a throwaway database so `npm test` never touches dev/prod data.
# TODO(Rolando): swap in the real test cluster URI.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<test-cluster>/<test-db>?retryWrites=true&w=majority

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
JWT_SECRET=
